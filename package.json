{
  "name": "fussy-eater-club-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:d1:migrate:local": "wrangler d1 migrations apply fussy-eater-club --local",
    "cf:d1:seed:local": "wrangler d1 execute fussy-eater-club --local --file ./migrations/seed_dev.sql",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "openapi-typescript ./specs/api/tsp-output/@typespec/openapi3/openapi.yaml -o ./src/lib/api-types.d.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260321.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "eslint": "^9.7.0",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "svelte": "^5.53.12",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.8.0"
  },
  "type": "module"
}