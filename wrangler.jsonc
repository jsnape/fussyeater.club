{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "fussyeater-club",
    "compatibility_date": "2026-03-29",
    "compatibility_flags": ["nodejs_als"],
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "d1-fussyeater-prod",
            "database_id": "61d7bbe1-0107-4ce2-8a33-33d0787f49c9",
            "preview_database_id": "61d7bbe1-0107-4ce2-8a33-33d0787f49c9"
        }
    ],
    "routes": [
        {
            "pattern": "fussyeater.club",
            "custom_domain": true
        }
    ],
    "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": true,
            "persist": true,
            "head_sampling_rate": 1
        }
    },
    "workers_dev": true,
    "preview_urls": true
}
