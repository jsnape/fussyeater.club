<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>FussyEaterClub.Api</RootNamespace>
  </PropertyGroup>

<PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\openapi-output</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--openapi-version OpenApi3_0</OpenApiGenerateDocumentsOptions>
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
<PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    <PrivateAssets>all</PrivateAssets>
</PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FussyEaterClub.Application\FussyEaterClub.Application.csproj" />
    <ProjectReference Include="..\FussyEaterClub.Infrastructure\FussyEaterClub.Infrastructure.csproj" />
  </ItemGroup>

</Project>
