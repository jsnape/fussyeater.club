{
  "name": "fussy-eater-club-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "openapi-typescript ../specs/api/tsp-output/@typespec/openapi3/openapi.yaml -o ./src/lib/api-types.d.ts"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "eslint": "^9.7.0",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "svelte": "^5.53.12",
    "svelte-adapter-azure-swa": "^0.22.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "type": "module"
}
