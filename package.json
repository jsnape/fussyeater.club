{
  "name": "fussyeater.club",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "preview:quiet": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --log-level error",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "generate:types": "npm run build --prefix specs/api && npm exec --yes -- openapi-typescript specs/api/tsp-output/@typespec/openapi3/openapi.yaml -o src/lib/api-types.d.ts",
    "gen": "wrangler types",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25",
    "@types/pluralize": "^0.0.33",
    "@vitest/browser-playwright": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-blocks": "^2.1.0",
    "flowbite-svelte-icons": "^3.1.0",
    "flowbite-typography": "^1.0.5",
    "globals": "^17.6.0",
    "mdsvex": "^0.12.7",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "tailwindcss-mcp-server": "^0.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.4",
    "uipro-cli": "^2.2.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.7",
    "vitest-browser-svelte": "^2.1.1",
    "wrangler": "^4.93.0"
  },
  "dependencies": {
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "pluralize": "^8.0.0"
  }
}
